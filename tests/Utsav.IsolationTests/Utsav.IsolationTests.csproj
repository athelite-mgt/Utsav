<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <!-- One decodable-PNG builder, shared with the unit tests rather than copied. -->
  <ItemGroup>
    <Compile Include="..\Utsav.UnitTests\Reports\TestImages.cs" Link="Support\TestImages.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Utsav.Domain\Utsav.Domain.csproj" />
    <ProjectReference Include="..\..\src\Utsav.Infrastructure\Utsav.Infrastructure.csproj" />
    <ProjectReference Include="..\..\src\Utsav.Api\Utsav.Api.csproj" />
  </ItemGroup>

</Project>
