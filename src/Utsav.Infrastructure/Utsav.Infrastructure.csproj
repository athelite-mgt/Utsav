<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Utsav.Domain\Utsav.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Google.Apis.Auth" />
    <PackageReference Include="Microsoft.Azure.Cosmos" />
    <!--
      PrivateAssets="compile" (not "all" — see below): only this project ever
      touches the WebPush API, so its compile-time reference assembly
      shouldn't flow to Utsav.Api. Left to flow, WebPush's own dependency
      (Portable.BouncyCastle, root namespace Org.BouncyCastle) becomes
      visible to Utsav.Api's compiler, and "Org" stops binding as the existing
      static SqlParameter helper (AdvanceEndpoints.Org()) used throughout the
      endpoint files — it becomes ambiguous with the namespace instead,
      ~29 CS0118 errors across files this feature never touches.

      "compile" only, deliberately not "all": Utsav.Api is the actual host
      process, not another library — it still needs WebPush.dll and
      BouncyCastle.dll physically copied into its own output to run.
      PrivateAssets="all" also marks the *runtime* asset private, which
      stops that copy and the app fails at startup with
      FileNotFoundException: WebPush — confirmed by hitting exactly that.
    -->
    <PackageReference Include="WebPush" PrivateAssets="compile" />
    <PackageReference Include="Azure.Storage.Blobs" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
    <PackageReference Include="Microsoft.IdentityModel.Protocols.OpenIdConnect" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" />
    <!--
      Microsoft.EntityFrameworkCore.SqlServer pulls Microsoft.Data.SqlClient,
      which pulls System.Security.Cryptography.Pkcs 9.0.x transitively —
      flagged with moderate/high-severity advisories (GHSA-2fmv-rv2c-59x7,
      GHSA-846f-f764-76mx). Pinned forward to the latest net10.0-era release.
      Remove once SqlClient itself references a fixed version.
    -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" />
    <!-- Build-time only: `dotnet ef migrations` tooling. These entities are now
         the source of truth for the schema (code-first), so a fresh committee
         deployment is `dotnet ef database update` against an empty database. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

</Project>
