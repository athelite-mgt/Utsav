# Loaded automatically by `vite build` (production mode). Committed
# deliberately: these are client IDs, not secrets — they appear in every
# issued token and in the bundle shipped to every browser regardless. Keeps
# the CI build self-contained with no env plumbing to configure.
VITE_GOOGLE_CLIENT_ID=
VITE_ENTRA_CLIENT_ID=
VITE_ENTRA_TENANT_ID=
