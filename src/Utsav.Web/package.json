{
  "name": "durga-puja-finance",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Durga Puja committee finance & collection management",
  "scripts": {
    "dev": "concurrently -n web,api -c cyan,magenta \"vite\" \"npm:server\"",
    "server": "node --experimental-sqlite --disable-warning=ExperimentalWarning --env-file-if-exists=.env server/index.mjs",
    "build": "tsc -b && vite build",
    "start": "node --experimental-sqlite --disable-warning=ExperimentalWarning --env-file-if-exists=.env server/index.mjs",
    "preview": "vite preview",
    "import:excel": "node scripts/import-excel.mjs",
    "seed": "node --experimental-sqlite --disable-warning=ExperimentalWarning --env-file-if-exists=.env scripts/seed.mjs",
    "db:reset": "node -e \"require('fs').rmSync('data',{recursive:true,force:true})\" && npm run seed"
  },
  "dependencies": {
    "@azure/msal-browser": "^5.18.0",
    "@radix-ui/react-avatar": "^1.1.1",
    "@radix-ui/react-checkbox": "^1.1.2",
    "@radix-ui/react-dialog": "^1.1.2",
    "@radix-ui/react-dropdown-menu": "^2.1.2",
    "@radix-ui/react-label": "^2.1.0",
    "@radix-ui/react-popover": "^1.1.2",
    "@radix-ui/react-select": "^2.1.2",
    "@radix-ui/react-separator": "^1.1.0",
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-tabs": "^1.1.1",
    "@radix-ui/react-tooltip": "^1.1.4",
    "@tanstack/react-query": "^5.59.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "date-fns": "^3.6.0",
    "express": "^5.2.1",
    "google-auth-library": "^11.0.0",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "jsqr": "^1.4.0",
    "lucide-react": "^0.451.0",
    "pg": "^8.22.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.53.0",
    "react-router-dom": "^6.26.2",
    "recharts": "^2.12.7",
    "serverless-http": "^3.2.0",
    "sonner": "^1.5.0",
    "tailwind-merge": "^2.5.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.7.4",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.2",
    "autoprefixer": "^10.4.20",
    "concurrently": "^10.0.3",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.13",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.6.2",
    "vite": "^5.4.8",
    "xlsx": "^0.18.5"
  }
}
